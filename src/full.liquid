<div class="layout layout--col layout--center-y wkc p--6 lg:p--10">
{% if days_until != 0 %}

  <div class="flex flex--row flex--center-y gap--xlarge w--full portrait:flex--col portrait:gap--large">
    <div class="wk-copy flex flex--col flex--left gap--small stretch">
      <span class="label wk-kicker text--gray-40">How long till the weekend?</span>
      <span class="title wk-quote" data-clamp="4">{{ quote }}</span>
    </div>

    {% render "wk_stack", days: days_until, caption: days_left_title, size: "wk-size--xl", rot_pool: rot_pool, off_pool: off_pool %}
  </div>

{% else %}

  <div class="flex flex--col flex--center-x gap--xlarge w--full">
    {% render "wk_word", size: "wk-tile--xl", tilt_pool: tilt_pool %}
    <span class="title wk-quote text--center" data-clamp="2">{{ quote }}</span>
  </div>

{% endif %}
</div>
