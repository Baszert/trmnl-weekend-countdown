<div class="layout layout--col layout--center-y wkc p--3 lg:p--6">
{% if days_until != 0 %}

  <div class="flex flex--row flex--center-y gap--small w--full">
    <div class="wk-copy flex flex--col flex--left stretch">
      <span class="title wk-quote wk-quote--sm" data-clamp="4">{{ quote }}</span>
    </div>

    {% render "wk_stack", days: days_until, caption: days_left_title, size: "wk-size--sm", rot_pool: rot_pool, off_pool: off_pool %}
  </div>

{% else %}

  <div class="flex flex--col flex--center-x gap--small w--full">
    {% render "wk_word", size: "wk-tile--sm", tilt_pool: tilt_pool %}
    <span class="title wk-quote wk-quote--sm text--center" data-clamp="2">{{ quote }}</span>
  </div>

{% endif %}
</div>
