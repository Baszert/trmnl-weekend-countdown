{% comment %} ---------- Which day is it, and how far is the weekend? ---------- {% endcomment %}
{% assign utc = trmnl.system.timestamp_utc %}
{% assign offset = trmnl.user.utc_offset %}
{% assign local_timestamp = utc | plus: offset %}
{% assign day_of_week = local_timestamp | date: "%w" | plus: 0 %}

{% if day_of_week == 6 or day_of_week == 0 %}
  {% assign days_until = 0 %}
{% else %}
  {% assign days_until = 6 | minus: day_of_week %}
{% endif %}

{% assign monday_quotes = "Monday. Nature's apology would be appreciated.|Ah yes, Monday. The reboot nobody asked for.|Welcome back to the weekly disappointment cycle.|Monday: where motivation goes to hide.|It's Monday. Pretend to care.|Monday. The universe's weekly reminder that joy is temporary.|New week, new sigh.|Happy Monday, just kidding.|Monday. The weekly betrayal begins again.|Oh look, Monday's here to ruin everything.|Monday: proof that weekends are too short.|Another Monday, another reason to question life choices.|Monday. Because even your coffee needs coffee.|Rise and despair, it's Monday.|Monday: aggressively unwelcome since forever." | split: "|" %}

