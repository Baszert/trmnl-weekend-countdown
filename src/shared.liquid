{% assign saturday_quotes = "Do nothing. You've earned it. Allegedly.|Saturday: where naps count as achievements.|Today's plan: not planning.|Weekend mode: on. Ambition: off.|Saturday. Chaos optional.|Saturday. Peak illusion of freedom.|Weekend mode on, brain mode off.|Saturday: built for denying responsibilities.|Enjoy today; tomorrow laughs at you.|Saturday, the only day that makes sense.|Yay for you, i don't care.|Saturday. Wasting time guilt-free since always.|Today's achievement: successfully doing nothing.|Saturday: proof you needed two days off, not one.|Peak freedom. Minimal motivation.|Saturday. Responsibilities can wait or whatever.|The only day that doesn't hate you back.|Saturday: aggressively unproductive and proud." | split: "|" %}

{% assign sunday_quotes = "Nothing ruins Sunday like Monday.|Sunday—time moves suspiciously fast.|Sunday: joy slowly declines.|Sunday. The calm before the doom.|Sunday. The pre-Monday dread simulator.|Half weekend, half existential crisis.|Enjoy today; tomorrow restarts the misery.|Sunday: joy slowly evaporates.|Sunday, countdown to chaos begins.|Sunday. Weekend's funeral service.|The anxiety is free, the weekend costs everything.|Sunday: where relaxation meets impending doom.|Enjoy this, Monday's already laughing.|Sunday. Technically still weekend, emotionally already Monday.|The day optimism dies weekly.|Sunday: denial's last stand before reality hits." | split: "|" %}

{% assign quote = "well this is awkward" %}
{% assign days_left_title = "days left" %}
{% case day_of_week %}
  {% when 1 %}{% assign quote = monday_quotes | sample %}
  {% when 2 %}{% assign quote = tuesday_quotes | sample %}
  {% when 3 %}{% assign quote = wednesday_quotes | sample %}
  {% when 4 %}{% assign quote = thursday_quotes | sample %}
  {% when 5 %}
    {% assign quote = friday_quotes | sample %}
    {% assign days_left_title = "day left" %}
  {% when 6 %}{% assign quote = saturday_quotes | sample %}
  {% when 0 %}{% assign quote = sunday_quotes | sample %}
{% endcase %}

{% comment %} Pools for the messy stack: sampled per sheet, so every refresh looks different {% endcomment %}
{% assign rot_pool = "-8,-6,-5,-4,-3,3,4,5,6,8" | split: "," %}
{% assign off_pool = "-6,-4,-2,0,2,4,6" | split: "," %}
{% assign tilt_pool = "-6,-4,-3,3,4,6" | split: "," %}

<style>
  /* Everything scoped to .wkc; sizes scale with the screen through --ui-scale.
     No custom font: the TRMNL font comes from the framework. */
  .wkc .wk-copy { min-width: 0; }
  .wkc .wk-kicker { font-size: calc(18px * var(--ui-scale, 1)); line-height: 1.2; }
  .wkc .wk-quote  { font-size: calc(30px * var(--ui-scale, 1)); line-height: 1.15; font-weight: 800; font-variation-settings: "wght" 800; }
  .wkc .wk-quote--md { font-size: calc(22px * var(--ui-scale, 1)); }
  .wkc .wk-quote--sm { font-size: calc(17px * var(--ui-scale, 1)); }

  /* The stack: every sheet fills the square, offsets and rotation come from Liquid */
  .wkc .wk-stack { position: relative; width: var(--wk-size); aspect-ratio: 1 / 1; flex: 0 0 auto; }
  .wkc .wk-sheet {
    position: absolute; inset: 0;
    background: #fff;
    border: calc(3px * var(--ui-scale, 1)) solid #000;
    border-radius: calc(14px * var(--ui-scale, 1));
  }
  .wkc .wk-sheet--top {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: calc(2px * var(--ui-scale, 1));
    box-shadow: calc(8px * var(--ui-scale, 1)) calc(8px * var(--ui-scale, 1)) 0 rgba(0, 0, 0, 0.22);
    z-index: 5;
  }
  .wkc .wk-num { font-size: calc(var(--wk-size) * 0.54); line-height: 0.88; font-weight: 800; font-variation-settings: "wght" 800; letter-spacing: -0.03em; }
  .wkc .wk-cap { font-size: calc(var(--wk-size) * 0.11); font-weight: 800; font-variation-settings: "wght" 800; text-transform: uppercase; letter-spacing: 0.06em; }

  /* WEEKEND tiles */
  .wkc .wk-word { display: flex; gap: calc(var(--wk-tile) * 0.14); }
  .wkc .wk-tile {
    width: var(--wk-tile); aspect-ratio: 1 / 1;
    background: #fff;
    border: calc(3px * var(--ui-scale, 1)) solid #000;
    border-radius: calc(12px * var(--ui-scale, 1));
    display: flex; align-items: center; justify-content: center;
    font-size: calc(var(--wk-tile) * 0.6); line-height: 1;
    font-weight: 800; font-variation-settings: "wght" 800;
    box-shadow: calc(5px * var(--ui-scale, 1)) calc(5px * var(--ui-scale, 1)) 0 rgba(0, 0, 0, 0.22);
  }

  /* Sizes per layout */
  .wkc .wk-size--xl { --wk-size: calc(240px * var(--ui-scale, 1)); }
  .wkc .wk-size--md { --wk-size: calc(150px * var(--ui-scale, 1)); }
  .wkc .wk-size--sm { --wk-size: calc(110px * var(--ui-scale, 1)); }
  .wkc .wk-tile--xl { --wk-tile: calc(84px * var(--ui-scale, 1)); }
  .wkc .wk-tile--md { --wk-tile: calc(46px * var(--ui-scale, 1)); }
  .wkc .wk-tile--sm { --wk-tile: calc(34px * var(--ui-scale, 1)); }
</style>


{% comment %} ---------- Templates ---------- {% endcomment %}

{% comment %} A messy stack of sheets: one per day left, the top one carries the number {% endcomment %}
{% template wk_stack %}
<div class="wk-stack {{ size }}">
  {% for i in (1..days) %}
    {% if forloop.last %}
    <div class="wk-sheet wk-sheet--top">
      <span class="value wk-num">{{ days }}</span>
      <span class="label wk-cap">{{ caption }}</span>
    </div>
    {% else %}
      {% assign a = rot_pool | sample %}
      {% assign dx = off_pool | sample %}
      {% assign dy = off_pool | sample %}
    <div class="wk-sheet" style="transform: translate({{ dx }}%, {{ dy }}%) rotate({{ a }}deg);"></div>
    {% endif %}
  {% endfor %}
</div>
{% endtemplate %}

{% comment %} WEEKEND in tiles, each one tilted a little {% endcomment %}
{% template wk_word %}
<div class="wk-word {{ size }}">
  {% assign letters = "WEEKEND" | split: "" %}
  {% for letter in letters %}
    {% assign a = tilt_pool | sample %}
  <div class="value wk-tile" style="transform: rotate({{ a }}deg);">{{ letter }}</div>
  {% endfor %}
</div>
{% endtemplate %}
