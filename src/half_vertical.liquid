<div class="layout layout--col layout--center-y wkc p--4 lg:p--8">
{% if days_until != 0 %}

  <div class="flex flex--col flex--center-x gap--xlarge w--full">
    {% render "wk_stack", days: days_until, caption: days_left_title, size: "wk-size--md", rot_pool: rot_pool, off_pool: off_pool %}

    <div class="wk-copy flex flex--col flex--center-x gap--xsmall w--full">
      <span class="label wk-kicker text--gray-40 text--center">How long till the weekend?</span>
      <span class="title wk-quote wk-quote--md text--center" data-clamp="4">{{ quote }}</span>
    </div>
  </div>

{% else %}

  <div class="flex flex--col flex--center-x gap--xlarge w--full">
    {% render "wk_word", size: "wk-tile--md", tilt_pool: tilt_pool %}
    <span class="title wk-quote wk-quote--md text--center" data-clamp="3">{{ quote }}</span>
  </div>

{% endif %}
</div>
